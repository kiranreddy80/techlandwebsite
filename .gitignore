node_modules

# Local environment files — never commit real credentials.
# .env.example and .env.production (public API URLs only) stay tracked.
.env
.env.local
.env.*.local

# Build output
.vite
*.log

# Hand-off archives. Zipping dist/ to send somewhere is fine; committing a
# 240MB zip of files already tracked beside it is not.
*.zip
