# Admin Panel Production Environment Variables

# The backend API this build talks to. Must be the SAME host the frontend uses,
# otherwise the site will not show what you upload here.
#
# IMPORTANT: Vite bakes this value into the bundle at BUILD time, not run time.
# Changing it means you must run `npm run build` again and redeploy.
#
# Because the admin panel and the API sit on different origins, the login cookie
# is issued as SameSite=None; Secure — so the API must be served over HTTPS in
# production or login will silently fail.
#
# TODO: set this to your new API host once it is live.
VITE_API_URL=https://techland-backend.onrender.com
