# Techland IT Solutions — static hosting rules for the built frontend.
#
# This file lives in public/ so Vite copies it into dist/ on every build. It is
# for Apache hosts (Hostinger, cPanel, most shared hosting). On nginx use the
# equivalent `try_files $uri $uri/ /index.html;` instead — see DEPLOYMENT.md.

# ----------------------------------------------------------------- routing
# The site is a single-page app: only /index.html exists on disk. Without the
# rule below, opening https://techlanditsolutions.com/portfolio directly (a
# bookmark, a Google result, a refresh) returns a 404, because there is no
# "portfolio" file. Everything that is not a real file or directory has to be
# handed to index.html so React Router can resolve it in the browser.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Never swallow API calls — if the backend is ever proxied on this same
  # domain, these must pass through untouched.
  RewriteRule ^api/ - [L]

  # Real files and directories are served as-is.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else is a client-side route.
  RewriteRule ^ index.html [L]
</IfModule>

# ----------------------------------------------------------------- caching
# Asset filenames carry a content hash (app-B_CnMBLl.js), so a changed file is
# a changed name. They can be cached hard and forever.
# index.html must NOT be cached, or visitors keep loading an old build that
# points at asset names which no longer exist.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType font/woff2              "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|webp|png|jpe?g|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# ------------------------------------------------------------- compression
# Text assets compress by roughly 3-4x. Images and fonts are already
# compressed, so squeezing them again only burns CPU.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ------------------------------------------------------------------ mime
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>
